# Optional. When set, POST /api/inquiry/ forwards the inquiry JSON to this URL.
# Use an https endpoint you control (CRM, Slack incoming webhook, or mail relay).
# Leave unset to accept inquiries and write them to the server log only.
#
# Production (Cloudflare Pages): do not commit a real URL. Set a secret instead:
#   npx wrangler pages secret put INQUIRY_WEBHOOK_URL --project-name=panpanauto
# Local Pages dev (`npm run pages:dev`) reads .dev.vars, which is gitignored:
#   INQUIRY_WEBHOOK_URL=https://example.com/hooks/inquiry
INQUIRY_WEBHOOK_URL=
